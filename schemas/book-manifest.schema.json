{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zopair.github.io/Amazon-work-/schemas/book-manifest.schema.json",
  "title": "Deterministic Children's Book Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book_id", "title", "locales", "page_count", "content_source", "artwork", "kdp_profile", "seed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "locales": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"}
    },
    "age_range": {"type": "string", "default": "3-6"},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "content_source": {"enum": ["approved_python_module"]},
    "artwork": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "output_dir", "width", "height", "format"],
      "properties": {
        "mode": {"enum": ["procedural_pillow", "approved_external_art"]},
        "output_dir": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "format": {"enum": ["JPEG", "PNG"]}
      }
    },
    "kdp_profile": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0},
    "character_bible": {"type": "string"},
    "status": {"enum": ["draft", "approved"]}
  }
}
